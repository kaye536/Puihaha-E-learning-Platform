# Copy this file to ".env" ON THE SERVER (htdocs/.env) and fill in the DB values from InfinityFree.
APP_NAME="Puihaha Membership Platform"
APP_ENV=production
APP_KEY=base64:wOVVOhyE4qKjGbI+X1Xu/SflmLZHak41cq+LesYZmXE=
APP_DEBUG=false
APP_URL=https://YOURSITE.infinityfreeapp.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# From InfinityFree > MySQL Databases (NOT localhost, NOT root)
DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_XXXXXXXX_membership
DB_USERNAME=if0_XXXXXXXX
DB_PASSWORD=YOUR_VPANEL_PASSWORD

# InfinityFree has no Redis/workers/cron: keep these simple
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# PHP mail() is disabled on InfinityFree. Use an external SMTP (e.g. Gmail App Password, Brevo, Zoho).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=YOUR_APP_PASSWORD
MAIL_FROM_ADDRESS="youraddress@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

OPENWEATHER_KEY=
