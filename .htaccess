# InfinityFree: web root is always htdocs, so route every request into /public.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Never serve dotfiles such as .env
<FilesMatch "^\.(?!htaccess$)">
    Require all denied
</FilesMatch>
Options -Indexes
